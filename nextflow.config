    rscript = "/mnt/gpfs1/Users/yangjinxurong/software/miniconda3/envs/stats/bin/Rscript"
    plink2 = "/mnt/gpfs1/Users/yangjinxurong/software/miniconda3/envs/wgs_tools/bin/plink2"
    python = "/mnt/gpfs1/Users/yangjinxurong/software/miniconda3/envs/stats/bin/python3"
    bcftools = "/mnt/gpfs/Software/bcftools"
    tabix = "/mnt/gpfs/Users/fanlei/software/STRetch_failed/tools/miniconda/envs/STR/bin/tabix"
    bgzip = "/mnt/gpfs/Users/fanlei/software/STRetch_failed/tools/miniconda/envs/STR/bin/bgzip"
    singularity = "/usr/bin/singularity"
    glnexus = "/mnt/gpfs1/Users/yangjinxurong/software/singularity/glnexus_v1.4.1.sif"

    vep_plugin = "/mnt/gpfs/Users/yangjinxurong/software/vep/Plugins"
    vep_homo_113 = "/mnt/gpfs/Users/yangjinxurong/software/annotation/"
    vep_fasta = "/mnt/gpfs/Users/yangjinxurong/software/annotation/GRCh38_gencode_v44_CTAT_lib_Oct292023.plug-n-play/ctat_genome_lib_build_dir/ref_genome.fa"
    maxentscan_dir = "/mnt/gpfs/Users/fanlei/project/21.wgs_method_quality/01.database/MaxEntScan/fordownload"
    spliceai_snv = "/mnt/gpfs/Users/yangjinxurong/software/annotation/spliceai_scores.masked.snv.hg38.chr.vcf.gz"
    spliceai_indel = "/mnt/gpfs/Users/yangjinxurong/software/annotation/spliceai_scores.masked.indel.hg38.chr.vcf.gz"
    clinvar_vcf = "/mnt/gpfs/Users/yangjinxurong/software/annotation/clinvar.vcf.gz"
    loftee_dir = "/mnt/gpfs1/Users/yangjinxurong/projects/database/loftee-grch38"
    loftee_perl_compat_dir = "/mnt/gpfs1/Users/yangjinxurong/projects/database/loftee-grch38-compat"
    loftee_gerp_bigwig = "/mnt/gpfs1/Users/yangjinxurong/projects/database/loftee-grch38-resources/gerp_conservation_scores.homo_sapiens.GRCh38.bw"
    loftee_human_ancestor_fa = "/mnt/gpfs1/Users/yangjinxurong/projects/database/loftee-grch38-resources/human_ancestor.fa.gz"
    loftee_conservation_file = "/mnt/gpfs1/Users/yangjinxurong/projects/database/loftee-grch38-resources/loftee.sql"
    gnomad_v4_genomes_dir = "/mnt/gpfs1/Users/yangjinxurong/projects/database/gnomAD_v4.1_genomes"
    gnomad_v4_genomes_vep_dir = "/mnt/gpfs1/Users/yangjinxurong/projects/database/gnomAD_v4.1_genomes_vep_nochr"
    gnomad_v4_genomes_filename_prefix = "gnomad.genomes.v4.1.sites"    
