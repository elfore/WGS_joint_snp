    reference_fasta = "/mnt/gpfs/Users/yangjinxurong/software/annotation/GRCh38_gencode_v44_CTAT_lib_Oct292023.plug-n-play/ctat_genome_lib_build_dir/ref_genome.fa"
    bed_dir = "/mnt/gpfs1/Users/yangjinxurong/projects/WGS/snp/data/hg38_chrom_beds"
    snpeff_java = "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/snpeff/bin/java"
    snpeff_jar = "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/snpeff/share/snpeff-5.1-4/snpEff.jar"
    genome_version = "hg38"
    contig_mode = "reference_intersection"
    auto_detect_reference_fai = true

}

manifest {
    name = 'merged_gvcf_normalization_joint_call_annotation'
    author = 'Bioinformatics Team'
    description = 'Merged gVCF header normalization, chromosome-split joint calling, and chromosome-split VEP/SnpEff annotation workflow'
    version = '2.0.0'
}

process {
    ignore_selector_warnings = true
    executor = 'sge'
    penv = 'smp'
    clusterOptions = '-S /bin/bash -V -cwd -q all.q'
    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2
    maxForks = params.process_max_forks ?: 8

    cpus = 1
    memory = '4 GB'

    withName: DISCOVER_GVCFS {
        cpus = 1
        memory = '4 GB'
        maxForks = 1
    }

    withName: BUILD_CONTIG_TEMPLATE {
        cpus = 1
        memory = '4 GB'
        maxForks = 1
    }

    withName: REHEADER_GVCF {
        cpus = 1
        memory = '8 GB'
        maxForks = 8
    }

    withName: JOINT_CALL {
        cpus = 4
        memory = "72 GB"
        maxForks = params.joint_call_max_forks ?: 2
        clusterOptions = "-S /bin/bash -V -cwd -q RAM -P p_ram"
    }

    withName: FILTER_JOINT_VCF {
        cpus = 1
        memory = "1 GB"
    }

    withName: LIFTOVER_CHR {
        cpus = 1
        memory = "1 GB"
    }

    withName: ANNOTATE_CHR {
        cpus = 8
        memory = "16 GB"
        maxForks = params.annotation_max_forks ?: 2
        clusterOptions = "-S /bin/bash -V -cwd -q RAM -P p_ram"
    }

    withName: MERGE_ANNOTATED_VCF {
        cpus = 2
        memory = "2 GB"
        maxForks = 1
    }
}

executor {
    queueSize = 40
}

cleanup = false
