/*
========================================================================================
    Nextflow 引擎核心运行时参数
========================================================================================
*/

// 强制启用 DSL2 语法规范
nextflow.enable.dsl = 2

// 自动化生成运行日志报告（存放在输出目录的 pipeline_info 下）
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}


//=========================================================================================
//底层生信工具软件/镜像路径 (固定的基础设施配置)
//=========================================================================================
//内部 Java 环境 (用于运行 snpEff)
params { 
    java = "/mnt/gpfs/Users/lilei/software/miniconda3/bin/java"
    gatk_jar = "/mnt/gpfs/Users/lilei/software/miniconda3/envs/gatk4/share/gatk4-4.3.0.0-0/gatk-package-4.3.0.0-local.jar"
    bcftools      = "/mnt/gpfs/Software/bcftools"
    snpeff_jar = "/mnt/gpfs/Users/lilei/software/snpEff/snpEff/snpEff.jar"
    tabix = "/mnt/gpfs/Users/fanlei/software/STRetch_failed/tools/miniconda/envs/STR/bin/tabix"
    bgzip = "/mnt/gpfs/Users/fanlei/software/STRetch_failed/tools/miniconda/envs/STR/bin/bgzip"
    // Singularity 容器执行命令
    singularity = "/usr/bin/singularity"
    glnexus = "/mnt/gpfs1/Users/yangjinxurong/software/singularity/glnexus_v1.4.1.sif"
    vep_sif = "/mnt/gpfs/Users/lilei/tools/vep/vep.sif"
    // GRCh38
    vep_plugin = "/mnt/gpfs/Users/yangjinxurong/software/vep/Plugins"
    vep_homo_113 = "/mnt/gpfs/Users/yangjinxurong/software/annotation/"
    snpeff_java = "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/snpeff/bin/java"
    snpeff_jar = "/mnt/gpfs/Users/yangjinxurong/software/miniconda3/envs/snpeff/share/snpeff-5.1-4/snpEff.jar"
}

/*
========================================================================================
    Process 资源精细化调度配置 (针对 25 条染色体高并发调优)
========================================================================================
*/


/*
========================================================================================
    执行环境与错误容忍策略
========================================================================================
*/

// 针对单染色体运行可能出现的偶然性资源不足，配置自动重试机制
process {
    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// 基础元数据描述
manifest {
    name            = 'main_snp_parallel'
    author          = 'Bioinformatics Team'
    description     = 'GATK4 全基因组多样本按染色体拆分并行联合分型及高级 VEP 临床注释流程'
    version         = '1.0.0'
}

process {
    ignore_selector_warnings = true
    executor = 'sge'
    maxForks = 5
    
    penv     = 'smp'
    clusterOptions = '-S /bin/bash -V -cwd -q RAM -P p_ram'

    cpus   = 2
    memory = '4 GB'

    // 针对旧标签 big_mem 的兼容
    withLabel: big_mem {
        cpus   = 20
        clusterOptions = '-S /bin/bash -V -cwd -q RAM -P p_ram'
    }

    // // 1. GenomicsDBImport 阶段
    // withName: import_db {
    //     cpus   = 4
    //     memory = '16 GB' 
    //     // 此时 Nextflow 会自动向集群投递：-pe smp 4
    // }
    
    // 2. GenotypeGVCFs 阶段
    withName: joint_call {
        cpus   = 4
        memory = '8 GB'
        // 此时 Nextflow 会自动向集群投递：-pe smp 4
    }
    
    // 3. bcftools concat 合并阶段
    withName: merge_vcf {
        cpus   = 2
        memory = '4 GB'
        // 此时 Nextflow 会自动向集群投递：-pe smp 2
    }
    
    // 4. VEP 临床级别高级注释
    withLabel: big_mem_2 {
        cpus    = 12
        clusterOptions = '-S /bin/bash -V -q RAM -P p_ram'
    }
}

cleanup = false